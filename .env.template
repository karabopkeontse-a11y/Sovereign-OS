# Copy this file to .env and add your own provider credentials.
# Never commit .env. The repository .gitignore already excludes it.

# Choose at least one provider. Free-tier accounts may be rate-limited.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3-ultra-550b-a55b:free,cohere/north-mini-code:free

# Optional providers (leave blank unless configured on your account).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ZAI_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=
# Local Ollama example:
# OLLAMA_MODEL=your-installed-model
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Paid Mistral remains disabled unless you explicitly opt in.
MISTRAL_API_KEY=
SOVEREIGN_ENABLE_PAID_MISTRAL=false
